rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read/write access to all users for development
    // IMPORTANT: Change these rules before deploying to production
    match /{document=**} {
      allow read, write: if true;
    }
    
    // Production rules (uncomment when ready)
    // match /products/{productId} {
    //   allow read: if true;  // Everyone can read products
    //   allow write: if request.auth != null;  // Only authenticated users can write
    // }
    
    // match /price_entries/{entryId} {
    //   allow read: if true;  // Everyone can read price entries
    //   allow write: if request.auth != null;  // Only authenticated users can write
    // }
  }
} 